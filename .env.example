# ====================================
# Example Environment Configuration
# ====================================
# Copy this file to .env and fill in your values
# The .env file will be ignored by git for security

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ====================================
# Network Configuration
# ====================================
VERIFY_SSL=True
# Set to False only for development/testing with self-signed certificates

# ====================================
# Discord Integration (Optional)
# ====================================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# Uncomment and fill in if you want to use Discord feedback feature

# ====================================
# API URLs (Usually no need to change)
# ====================================
# GEORISQUES_URL=https://georisques.gouv.fr/services
# BRGM_WFS_URL=https://geoservices.brgm.fr/geologie
# IGN_WFS_URL=https://data.geopf.fr/wfs/ows
# INFOTERRE_URL=http://infoterre.brgm.fr/fiche/

# ====================================
# Application Configuration
# ====================================
# DEBUG=False
# Set to True only for development
